{
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/manus-storage/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
